<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NoShowCheckIn</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CheckIn__c, NoShow__c, ISCHANGED(CheckIn__c) )</errorConditionFormula>
    <errorDisplayField>CheckIn__c</errorDisplayField>
    <errorMessage>Check In e No Show não podem ser marcados simultaneamente</errorMessage>
</ValidationRule>
