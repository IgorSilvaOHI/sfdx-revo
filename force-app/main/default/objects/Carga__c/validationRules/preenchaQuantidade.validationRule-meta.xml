<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>preenchaQuantidade</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED( CheckIn__c ),
CheckIn__c ,
(ISBLANK(Quantidade__c)))</errorConditionFormula>
    <errorDisplayField>CheckIn__c</errorDisplayField>
    <errorMessage>Preencha o campo Quantidade</errorMessage>
</ValidationRule>
