<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SomenteAdmEditaVooCancelado</fullName>
    <active>true</active>
    <description>Somente administradores podem editar voos cancelados</description>
    <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &quot;Administrador do sistema&quot;,
ISPICKVAL(PRIORVALUE(Status__c), &apos;Cancelado&apos;))</errorConditionFormula>
    <errorMessage>Um voo cancelado não pode ser editado</errorMessage>
</ValidationRule>
