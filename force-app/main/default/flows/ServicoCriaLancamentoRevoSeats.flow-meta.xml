<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>ProdutoVinculadoValido</name>
        <label>Produto Vinculado é Valido</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Produto__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RevoSeats</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProdutoOportunidade__r.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CriarLancamentoMoedaRevoSeats</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>[Serviço] {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Serviço] Cria lançamento RevoSeats</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CriarLancamentoMoedaRevoSeats</name>
        <label>Criar Lançamento de Moeda RevoSeats</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>AtualizaLancamentoVinculado</targetReference>
        </connector>
        <inputAssignments>
            <field>Conta__c</field>
            <value>
                <elementReference>$Record.ContaComprador__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantidade__c</field>
            <value>
                <elementReference>$Record.ProdutoOportunidade__r.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SaldoAnterior__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ServicoOrigem__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tipo__c</field>
            <value>
                <stringValue>Crédito</stringValue>
            </value>
        </inputAssignments>
        <object>LancamentoRevoSeat__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>AtualizaLancamentoVinculado</name>
        <label>Atualiza Lançamento Vinculado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>LancamentoRevoSeat__c</field>
            <value>
                <elementReference>CriarLancamentoMoedaRevoSeats</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Executado</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ProdutoVinculadoValido</targetReference>
        </connector>
        <filterFormula>AND(
{!$Record.RecordType.DeveloperName} = &apos;RevoSeats&apos;,
OR( ISCHANGED({!$Record.Status__c} ), ISNEW() ),
ISPICKVAL({!$Record.Status__c}, &apos;Pago&apos;)
)</filterFormula>
        <object>Servico__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
