<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LimpeQuantidade</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED( NoShow__c ),
NoShow__c,
NOT(ISBLANK(Quantidade__c)))</errorConditionFormula>
    <errorDisplayField>NoShow__c</errorDisplayField>
    <errorMessage>Limpe o campo Quantidade</errorMessage>
</ValidationRule>
