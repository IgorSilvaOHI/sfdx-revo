<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DataBriefing</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(Briefing__c) == &apos;Não Realizado&apos;,
ISCHANGED(Briefing__c), 
NOT(ISNULL(DataBriefing__c)))</errorConditionFormula>
    <errorDisplayField>DataBriefing__c</errorDisplayField>
    <errorMessage>Limpe os dados de data briefing</errorMessage>
</ValidationRule>
