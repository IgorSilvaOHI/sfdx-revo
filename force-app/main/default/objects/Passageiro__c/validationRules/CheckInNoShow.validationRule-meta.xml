<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CheckInNoShow</fullName>
    <active>true</active>
    <errorConditionFormula>AND(CheckIn__c, NoShow__c,  ISCHANGED(NoShow__c) )</errorConditionFormula>
    <errorDisplayField>NoShow__c</errorDisplayField>
    <errorMessage>Check In e No Show não podem ser marcados simultaneamente</errorMessage>
</ValidationRule>
