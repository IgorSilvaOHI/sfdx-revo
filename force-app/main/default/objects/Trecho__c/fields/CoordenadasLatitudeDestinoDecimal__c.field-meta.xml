<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CoordenadasLatitudeDestinoDecimal__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
				CoordenadasDestinoAlteracao__c,
				IF(
								ISPICKVAL(CoordenadasLatitudeDestinoDirecao__c, &apos;S&apos;),
								-1 * (CoordenadasLatitudeDestinoGraus__c + ((CoordenadasLatitudeDestinoMinutos__c / 60) + (CoordenadasLatitudeDestinoSegundos__c / 3600))),
								(CoordenadasLatitudeDestinoGraus__c + ((CoordenadasLatitudeDestinoMinutos__c / 60) + (CoordenadasLatitudeDestinoSegundos__c / 3600)))
				),
				Destino__r.Coordenadas__Latitude__s 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Coordenadas Latitude Destino - Decimal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>18</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
