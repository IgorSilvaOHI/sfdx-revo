<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CoordenadasLatitudeOrigemDecimal__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
				CoordenadasOrigemAlteracao__c,
				IF(
								ISPICKVAL(CoordenadasLatitudeOrigemDirecao__c, &apos;S&apos;),
								-1 * (CoordenadasLatitudeOrigemGraus__c + ((CoordenadasLatitudeOrigemMinutos__c / 60) + (CoordenadasLatitudeOrigemSegundos__c / 3600))),
								(CoordenadasLatitudeOrigemGraus__c + ((CoordenadasLatitudeOrigemMinutos__c / 60) + (CoordenadasLatitudeOrigemSegundos__c / 3600)))
				), 
			 Origem__r.Coordenadas__Latitude__s 	
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Coordenadas Latitude Origem - Decimal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>18</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
