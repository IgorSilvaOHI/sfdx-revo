<aura:component implements="lightning:availableForFlowScreens" access="global">
    <div class="slds-illustration slds-illustration_large" aria-hidden="true">
        <img style="max-width: 300px;" src="/img/chatter/Desert.svg" class="slds-illustration__svg" alt=""/>
        <div class="slds-text-color_default" style="margin-bottom: 100px;">
            <p class="slds-text-body_regular">Não há nada para fazer aqui. </p>
        </div>
    </div>
</aura:component>