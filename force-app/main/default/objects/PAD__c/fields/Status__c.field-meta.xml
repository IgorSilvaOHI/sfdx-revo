<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Indica se o PAD está ativo ou inativo.</description>
    <externalId>false</externalId>
    <formula>IF(TODAY()&gt;= InicioVigencia__c  &amp;&amp; TODAY()&lt;= FimVigencia__c, &quot;Ativo&quot;,&quot;Inativo&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Indica se o PAD está ativo ou inativo.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
