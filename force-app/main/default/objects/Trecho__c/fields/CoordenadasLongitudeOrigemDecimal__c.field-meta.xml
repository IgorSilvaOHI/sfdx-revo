<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CoordenadasLongitudeOrigemDecimal__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
				CoordenadasOrigemAlteracao__c,
				IF(
								ISPICKVAL(CoordenadasLongitudeOrigemDirecao__c, &apos;O&apos;),
								-1 * (CoordenadasLongitudeOrigemGraus__c + ((CoordenadasLongitudeOrigemMinutos__c / 60) + (CoordenadasLongitudeOrigemSegundos__c / 3600))),
								(CoordenadasLongitudeOrigemGraus__c + ((CoordenadasLongitudeOrigemMinutos__c / 60) + (CoordenadasLongitudeOrigemSegundos__c / 3600)))
				),
				Origem__r.Coordenadas__Longitude__s 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Coordenadas Longitude Origem - Decimal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>18</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
